# Environment variables used by the test suite.
#
# `cargo test` loads `testing.env` from the crate root automatically (if the
# file exists) so tests that call the GitHub API can authenticate. Copy this
# template and fill in your token:
#
#   cp testing.env.example testing.env
#
# The file is gitignored. Variables already set in the environment take
# precedence over values from the file. GITHUB_PAT takes precedence over
# GITHUB_TOKEN.

# GITHUB_PAT=ghp_your_token_here
# GITHUB_TOKEN=your_token_here
